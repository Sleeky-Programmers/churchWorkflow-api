{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cron/guest-lifecycle",
      "schedule": "0 1 * * *"
    }
  ]
}
